# Usage:
#   1. cp .env.example .env
#   2. Replace the placeholder values in .env
# The .env file is git-ignored

# Postgres administrator user (used to create the application database and user)
POSTGRES_USER=change_me_admin_user
POSTGRES_PASSWORD=change_me_admin_password

# Application database and user (created by postgres/init_db.sh)
EMPLOYEE_DB_NAME=employee_db
EMPLOYEE_DB_USER=change_me_user
EMPLOYEE_DB_PASSWORD=change_me_password